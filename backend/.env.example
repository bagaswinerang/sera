# Sectors (dapat setelah onboarding hackathon). Jangan di-commit .env asli!
SECTORS_API_KEY=your_sectors_api_key_here

# Gemini: key dari Google AI Studio.
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
# Model berurutan: yang pertama dipakai dulu, sisanya cadangan kalau kuota habis / error server.
GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash

# Server
PORT=8787
FRONTEND_ORIGIN=https://sera-ai-finance.vercel.app # Ganti dengan URL Vercel/Netlify produksi
# isi 1 jika di belakang proxy hosting (Railway/Render/dll.)
TRUST_PROXY=

# Supabase (opsional di awal: tanpa ini cache memakai memori server)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Batas keras kredit Sectors per proses server (kosong = tanpa batas). Disarankan saat demo, mis. 300.
CREDIT_BUDGET=300
